---

<section
  class="experience-section section-py"
  aria-labelledby="experience-heading"
>
  <div class="container-base">
    <!-- Header -->
    <div class="exp-header reveal">
      <p class="eyebrow mb-5">Pengalaman Kami</p>
      <h2 id="experience-heading" class="section-heading mb-4">
        Bukan hanya kopi —<br />
        <em class="italic" style="color: var(--color-caramel)">sebuah pengalaman.</em>
      </h2>
      <p class="section-sub">
        Kami percaya bahwa waktu yang kamu habiskan bersama kami
        harus terasa special, bukan sekadar biasa.
      </p>
    </div>

    <!-- Experience grid -->
    <ul class="exp-grid" role="list">
      {experiences.map((exp, i) => (
        <li class={`exp-item reveal delay-${(i % 3 + 1) * 100}`}>
          <div class="exp-icon" aria-hidden="true" set:html={exp.icon} />
          <h3 class="exp-title">{exp.title}</h3>
          <p class="exp-desc">{exp.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .experience-section {
    background-color: var(--color-cream);
  }

  .exp-header {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: 4rem;
  }

  .exp-header .section-sub {
    margin-inline: auto;
  }

  /* Grid */
  .exp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .exp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .exp-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  /* Item */
  .exp-item {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background-color: var(--color-white);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .exp-item:hover {
    border-color: var(--color-sand);
    box-shadow: 0 4px 24px rgba(28,20,16,0.07);
  }

  /* Icon */
  .exp-icon {
    width: 48px;
    height: 48px;
    background-color: var(--color-sand);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brown);
    margin-bottom: 1.25rem;
  }

  /* Title */
  .exp-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-espresso);
    margin-bottom: 0.6rem;
  }

  /* Desc */
  .exp-desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
</style>
