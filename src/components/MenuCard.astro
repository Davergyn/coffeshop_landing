---
// MenuCard.astro — Reusable menu card component

import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
  showImage?: boolean;
  variant?: 'signature' | 'list';
}

const { item, showImage = true, variant = 'signature' } = Astro.props;

// Curated Unsplash images mapped by item ID
const itemImages: Record<string, string> = {
  'es-kopi-susu':        'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?w=600&q=80&auto=format&fit=crop',
  'americano':           'https://images.unsplash.com/photo-1497515114629-f71d768fd07c?w=600&q=80&auto=format&fit=crop',
  'latte':               'https://images.unsplash.com/photo-1534778101976-62847782c213?w=600&q=80&auto=format&fit=crop',
  'v60':                 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&q=80&auto=format&fit=crop',
  'matcha-latte':        'https://images.unsplash.com/photo-1536256263959-770b48d82b0a?w=600&q=80&auto=format&fit=crop',
  'croissant':           'https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=600&q=80&auto=format&fit=crop',
  'cappuccino':          'https://images.unsplash.com/photo-1572442388796-11668a67e53d?w=600&q=80&auto=format&fit=crop',
  'cold-brew':           'https://images.unsplash.com/photo-1610889556528-9a770e32642f?w=600&q=80&auto=format&fit=crop',
  'signature-brown-sugar': 'https://images.unsplash.com/photo-1561882468-9110d70d2f96?w=600&q=80&auto=format&fit=crop',
  'banana-bread':        'https://images.unsplash.com/photo-1586444248902-2f64eddc13df?w=600&q=80&auto=format&fit=crop',
};

const imgSrc = item.image || itemImages[item.id] || 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&q=80&auto=format&fit=crop';
---

{variant === 'signature' ? (
  <article class="menu-card" aria-label={item.name}>
    {showImage && (
      <div class="menu-card-img-wrap">
        <img
          src={imgSrc}
          alt={`${item.name} — ${item.description.slice(0, 50)}`}
          width="600"
          height="400"
          loading="lazy"
          decoding="async"
          class="menu-card-img"
        />
        {item.isBestSeller && (
          <span class="badge-bestseller" aria-label="Best Seller">Best Seller</span>
        )}
      </div>
    )}
    <div class="menu-card-body">
      <h3 class="menu-card-name">{item.name}</h3>
      <p class="menu-card-desc">{item.description}</p>
      <p class="menu-card-price" aria-label={`Harga: ${item.price}`}>{item.price}</p>
    </div>
  </article>
) : (
  <article class="menu-list-item" aria-label={item.name}>
    <div class="menu-list-info">
      <div class="menu-list-name-wrap">
        <h3 class="menu-list-name">{item.name}</h3>
        {item.isBestSeller && (
          <span class="badge-bestseller-sm" aria-label="Best Seller">★ Favorit</span>
        )}
      </div>
      <p class="menu-list-desc">{item.description}</p>
    </div>
    <p class="menu-list-price" aria-label={`Harga: ${item.price}`}>{item.price}</p>
  </article>
)}

<style>
  /* ── SIGNATURE CARD ── */
  .menu-card {
    background-color: var(--color-white);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .menu-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(28,20,16,0.1);
  }

  .menu-card-img-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .menu-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .menu-card:hover .menu-card-img {
    transform: scale(1.04);
  }

  .badge-bestseller {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: var(--color-caramel);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 9999px;
  }

  .menu-card-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .menu-card-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-espresso);
    margin-bottom: 0.5rem;
  }

  .menu-card-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .menu-card-price {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-brown);
    letter-spacing: 0.01em;
  }

  /* ── LIST ITEM ── */
  .menu-list-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .menu-list-item:last-child {
    border-bottom: none;
  }

  .menu-list-info {
    flex: 1;
    min-width: 0;
  }

  .menu-list-name-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .menu-list-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-espresso);
  }

  .badge-bestseller-sm {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-caramel);
    border: 1px solid var(--color-caramel);
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
  }

  .menu-list-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .menu-list-price {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-brown);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 0.1rem;
  }
</style>
