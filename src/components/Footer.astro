---
// Footer.astro — Site footer

const navLinks = [
  { label: "Home",     href: "#home" },
  { label: "About",    href: "#about" },
  { label: "Menu",     href: "#menu" },
  { label: "Gallery",  href: "#gallery" },
  { label: "Location", href: "#location" },
];

const whatsappNumber = "[WHATSAPP NUMBER]";
const instagramUrl   = "[INSTAGRAM URL]";
const googleMapsUrl  = "[GOOGLE MAPS URL]";
const whatsappUrl    = `https://wa.me/${whatsappNumber}`;
const currentYear    = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container-base">
    <!-- Top section -->
    <div class="footer-top">
      <!-- Brand column -->
      <div class="footer-brand">
        <!-- Logo -->
        <a href="#home" class="footer-logo" aria-label="[COFFEE SHOP NAME] — kembali ke atas">
          <span class="footer-logo-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="14" cy="14" rx="11" ry="9" fill="currentColor" opacity="0.15"/>
              <ellipse cx="14" cy="14" rx="11" ry="9" stroke="currentColor" stroke-width="1.5"/>
              <path d="M14 5.5 C14 5.5 10 11 10 14 C10 17 14 22.5 14 22.5 C14 22.5 18 17 18 14 C18 11 14 5.5 14 5.5Z" stroke="currentColor" stroke-width="1.2" fill="none"/>
            </svg>
          </span>
          <span class="footer-logo-text font-display">[COFFEE SHOP NAME]</span>
        </a>

        <p class="footer-tagline">
          Specialty coffee dan ruang yang hangat untuk setiap momenmu.
          Hadir setiap hari, menanti di [CITY].
        </p>

        <!-- Social links -->
        <div class="footer-social">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Ikuti kami di Instagram"
            id="footer-instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Chat via WhatsApp"
            id="footer-whatsapp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Nav column -->
      <div class="footer-nav-col">
        <h3 class="footer-col-title">Navigasi</h3>
        <ul class="footer-nav" role="list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Info column -->
      <div class="footer-info-col">
        <h3 class="footer-col-title">Info</h3>
        <ul class="footer-info-list" role="list">
          <li class="footer-info-item">
            <span class="footer-info-label">Alamat</span>
            <address class="footer-info-val not-italic">
              [STREET ADDRESS]<br />
              [CITY], Indonesia
            </address>
          </li>
          <li class="footer-info-item">
            <span class="footer-info-label">Jam Buka</span>
            <span class="footer-info-val">
              Senin–Jumat: 08:00–22:00<br />
              Sabtu–Minggu: 07:00–23:00
            </span>
          </li>
          <li class="footer-info-item">
            <span class="footer-info-label">WhatsApp</span>
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="footer-link">
              [WHATSAPP NUMBER]
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <hr class="footer-divider" />

    <!-- Bottom -->
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} [COFFEE SHOP NAME]. Hak cipta dilindungi.
      </p>
      <p class="footer-made">
        Made with ☕ in [CITY]
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-espresso);
    color: var(--color-cream);
    padding-top: 4.5rem;
    padding-bottom: 2rem;
  }

  /* Top grid */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: 4rem;
    }
  }

  /* Brand */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    color: var(--color-cream);
  }

  .footer-logo-icon svg {
    color: var(--color-latte);
  }

  .footer-logo-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .footer-tagline {
    color: rgba(250, 247, 242, 0.6);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 36ch;
  }

  /* Social */
  .footer-social {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(250,247,242,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(250,247,242,0.7);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--color-latte);
    color: var(--color-latte);
  }

  /* Column title */
  .footer-col-title {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-latte);
    margin-bottom: 1.25rem;
  }

  /* Nav links */
  .footer-nav {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-link {
    font-size: 0.9rem;
    color: rgba(250, 247, 242, 0.65);
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-cream);
  }

  /* Info list */
  .footer-info-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .footer-info-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-info-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-caramel);
  }

  .footer-info-val {
    font-size: 0.875rem;
    color: rgba(250, 247, 242, 0.65);
    line-height: 1.6;
  }

  /* Divider */
  .footer-divider {
    border: none;
    border-top: 1px solid rgba(250,247,242,0.1);
    margin-bottom: 1.75rem;
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-copy,
  .footer-made {
    font-size: 0.8rem;
    color: rgba(250, 247, 242, 0.4);
    margin: 0;
  }
</style>
