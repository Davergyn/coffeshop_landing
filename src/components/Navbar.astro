---
// Navbar.astro — Sticky responsive navigation

const navLinks = [
  { label: "Home",     href: "#home" },
  { label: "About",    href: "#about" },
  { label: "Menu",     href: "#menu" },
  { label: "Gallery",  href: "#gallery" },
  { label: "Location", href: "#location" },
];

const whatsappNumber = "[WHATSAPP NUMBER]"; // Contoh: 6281234567890
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Halo,%20saya%20ingin%20memesan`;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  role="banner"
>
  <div class="container-base">
    <nav
      class="flex items-center justify-between py-5"
      aria-label="Main navigation"
    >
      <!-- Logo -->
      <a
        href="#home"
        class="logo flex items-center gap-2.5 focus-visible:outline-none"
        aria-label="[COFFEE SHOP NAME] — Kembali ke atas"
      >
        <!-- Coffee bean SVG icon -->
        <span class="logo-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="14" cy="14" rx="11" ry="9" fill="currentColor" opacity="0.12"/>
            <ellipse cx="14" cy="14" rx="11" ry="9" stroke="currentColor" stroke-width="1.5"/>
            <path d="M14 5.5 C14 5.5 10 11 10 14 C10 17 14 22.5 14 22.5 C14 22.5 18 17 18 14 C18 11 14 5.5 14 5.5Z" stroke="currentColor" stroke-width="1.2" fill="none"/>
          </svg>
        </span>
        <span class="logo-text font-display font-medium text-lg leading-none">
          [COFFEE SHOP NAME]
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="hidden lg:flex items-center gap-8 list-none" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link text-sm font-medium tracking-wide relative"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm"
          id="navbar-whatsapp-cta"
          aria-label="Order via WhatsApp"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Order via WhatsApp
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button
        id="hamburger-btn"
        class="lg:hidden p-2 -mr-2 rounded-lg"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-icon block" aria-hidden="true">
          <span class="bar block w-6 h-0.5 rounded-full mb-1.5 transition-all duration-300 bg-current"></span>
          <span class="bar block w-6 h-0.5 rounded-full mb-1.5 transition-all duration-300 bg-current"></span>
          <span class="bar block w-4 h-0.5 rounded-full transition-all duration-300 bg-current"></span>
        </span>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden mobile-menu overflow-hidden max-h-0 transition-all duration-300 ease-in-out"
    role="navigation"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <div class="container-base pb-6">
      <ul class="flex flex-col gap-1 list-none mb-6" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link block py-3 text-base font-medium border-b border-current/10 last:border-0"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary w-full text-center justify-center"
        id="mobile-whatsapp-cta"
        aria-label="Order via WhatsApp"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Order via WhatsApp
      </a>
    </div>
  </div>
</header>

<style>
  /* Navbar default state — transparent */
  #navbar {
    color: var(--color-cream);
  }

  #navbar .logo-icon svg {
    color: var(--color-cream);
  }

  /* Scrolled state — opaque */
  #navbar.scrolled {
    background-color: var(--color-cream);
    color: var(--color-espresso);
    box-shadow: 0 1px 0 var(--color-border);
  }

  #navbar.scrolled .logo-icon svg {
    color: var(--color-espresso);
  }

  #navbar.scrolled .btn-primary {
    background-color: var(--color-espresso);
    color: var(--color-cream);
  }

  /* Nav links */
  .nav-link {
    opacity: 0.8;
    transition: opacity 0.2s ease;
    padding-block: 0.25rem;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.25s ease;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Mobile nav */
  .mobile-menu {
    background-color: var(--color-cream);
    color: var(--color-espresso);
  }

  .mobile-menu.open {
    max-height: 400px;
  }

  .mobile-nav-link {
    opacity: 0.8;
    transition: opacity 0.2s ease;
    color: var(--color-espresso);
  }

  .mobile-nav-link:hover {
    opacity: 1;
  }

  /* Hamburger active state */
  #hamburger-btn.active .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  #hamburger-btn.active .bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  #hamburger-btn.active .bar:nth-child(3) {
    width: 1.5rem;
    transform: translateY(-8px) rotate(-45deg);
  }

  /* When scrolled, hamburger uses dark color */
  #navbar.scrolled #hamburger-btn .bar {
    background-color: var(--color-espresso);
  }
</style>

<script>
  const navbar = document.getElementById('navbar') as HTMLElement;
  const hamburgerBtn = document.getElementById('hamburger-btn') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;

  // Scroll handler
  const handleScroll = () => {
    if (window.scrollY > 60) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll(); // run on load

  // Mobile menu toggle
  hamburgerBtn.addEventListener('click', () => {
    const isOpen = hamburgerBtn.classList.toggle('active');
    mobileMenu.classList.toggle('open', isOpen);
    hamburgerBtn.setAttribute('aria-expanded', String(isOpen));
    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
  });

  // Close mobile menu when a link is clicked
  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      hamburgerBtn.classList.remove('active');
      mobileMenu.classList.remove('open');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
    });
  });
</script>
