---
// Navbar.astro - Sticky responsive navigation

const navLinks = [
  { label: "Home",     href: "#home" },
  { label: "About",    href: "#about" },
  { label: "Menu",     href: "#menu" },
  { label: "Gallery",  href: "#gallery" },
  { label: "Location", href: "#location" },
];

const whatsappNumber = "[WHATSAPP NUMBER]";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Halo,%20saya%20ingin%20memesan`;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  role="banner"
>
  <div class="container-base">
    <nav
      class="flex items-center justify-between py-5"
      aria-label="Main navigation"
    >
      <!-- Logo -->
      <a
        href="#home"
        class="logo flex items-center gap-2.5 focus-visible:outline-none"
        aria-label="[COFFEE SHOP NAME] - Kembali ke atas"
      >
        <span class="logo-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="14" cy="14" rx="11" ry="9" fill="currentColor" opacity="0.12"/>
            <ellipse cx="14" cy="14" rx="11" ry="9" stroke="currentColor" stroke-width="1.5"/>
            <path d="M14 5.5 C14 5.5 10 11 10 14 C10 17 14 22.5 14 22.5 C14 22.5 18 17 18 14 C18 11 14 5.5 14 5.5Z" stroke="currentColor" stroke-width="1.2" fill="none"/>
          </svg>
        </span>
        <span class="logo-text font-display font-medium text-lg leading-none">
          [COFFEE SHOP NAME]
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="hidden lg:flex items-center gap-8 list-none" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link text-sm font-medium tracking-wide relative"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm"
          id="navbar-whatsapp-cta"
          aria-label="Order via WhatsApp"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Order via WhatsApp
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        id="hamburger-btn"
        class="lg:hidden hamburger-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <span class="sr-only">Menu</span>
        <span class="hamburger-icon" aria-hidden="true">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
        </span>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="mobile-menu lg:hidden"
    role="navigation"
    aria-label="Mobile navigation"
    aria-hidden="true"
  >
    <div class="mobile-menu-inner container-base">
      <ul class="mobile-nav-list list-none" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary mobile-wa-btn"
        id="mobile-whatsapp-cta"
        aria-label="Order via WhatsApp"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Order via WhatsApp
      </a>
    </div>
  </div>
</header>


<style>
  /* ============================================================
     NAVBAR BASE
     ============================================================ */
  #navbar {
    color: var(--color-cream);
  }

  #navbar .logo-icon svg {
    color: var(--color-cream);
  }

  /* Scrolled state */
  #navbar.scrolled {
    background-color: var(--color-cream);
    color: var(--color-espresso);
    box-shadow: 0 1px 0 var(--color-border);
  }

  #navbar.scrolled .logo-icon svg {
    color: var(--color-espresso);
  }

  #navbar.scrolled .btn-primary {
    background-color: var(--color-espresso);
    color: var(--color-cream);
  }

  /* When mobile menu is open, always show cream bg on navbar */
  #navbar.menu-open {
    background-color: var(--color-cream);
    color: var(--color-espresso);
    box-shadow: 0 1px 0 var(--color-border);
  }

  #navbar.menu-open .logo-icon svg {
    color: var(--color-espresso);
  }

  /* ============================================================
     DESKTOP NAV LINKS
     ============================================================ */
  .nav-link {
    opacity: 0.8;
    transition: opacity 0.2s ease;
    padding-block: 0.25rem;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 0.25s ease;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* ============================================================
     HAMBURGER BUTTON
     ============================================================ */
  .hamburger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: 8px;
    padding: 0;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .hamburger-btn:focus-visible {
    outline: 2px solid var(--color-caramel);
    outline-offset: 2px;
  }

  @media (min-width: 1024px) {
    .hamburger-btn {
      display: none !important;
    }
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 22px;
    height: 16px;
    gap: 0;
    position: relative;
  }

  .bar {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
    position: absolute;
    left: 0;
    transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
    transform-origin: center;
  }

  .bar-1 { top: 0; }
  .bar-2 { top: 50%; transform: translateY(-50%); }
  .bar-3 { bottom: 0; }

  /* Active X state */
  .hamburger-btn.active .bar-1 {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  .hamburger-btn.active .bar-2 {
    opacity: 0;
    transform: translateY(-50%) scaleX(0);
  }

  .hamburger-btn.active .bar-3 {
    bottom: auto;
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  /* When scrolled or menu open, bars are dark */
  #navbar.scrolled .hamburger-btn .bar,
  #navbar.menu-open .hamburger-btn .bar {
    background-color: var(--color-espresso);
  }

  /* sr-only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* ============================================================
     MOBILE MENU DRAWER (FIXED GAP & OVERFLOW ISSUE)
     ============================================================ */
  .mobile-menu {
    background-color: var(--color-cream);
    color: var(--color-espresso);
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    opacity: 0;
    transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.35s ease,
                opacity 0.25s ease,
                box-shadow 0.35s ease;
    overflow: hidden;
  }

  .mobile-menu.open {
    grid-template-rows: 1fr;
    visibility: visible;
    opacity: 1;
    box-shadow: 0 4px 12px rgba(28, 20, 16, 0.08);
  }

  .mobile-menu-inner {
    overflow: hidden;
    min-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    transition: padding 0.35s ease;
  }

  .mobile-menu.open .mobile-menu-inner {
    padding-top: 0.5rem;
    padding-bottom: 1.5rem;
  }

  /* Nav list */
  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 1.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.875rem 0;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-espresso);
    border-bottom: 1px solid var(--color-border);
    opacity: 0.85;
    transition: opacity 0.2s ease, padding-left 0.2s ease;
    text-decoration: none;
  }

  .mobile-nav-link:last-child {
    border-bottom: none;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    opacity: 1;
    padding-left: 0.5rem;
  }

  /* WhatsApp CTA in mobile */
  .mobile-wa-btn {
    width: 100%;
    justify-content: center;
    margin-top: 0.25rem;
  }

</style>

<script>
  const navbar = document.getElementById('navbar');
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (!navbar || !hamburgerBtn || !mobileMenu) {
    console.warn('Navbar elements not found');
  } else {
    // ── SCROLL HANDLER ───────────────────────────────────────
    const handleScroll = () => {
      if (window.scrollY > 60) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // ── MOBILE MENU TOGGLE ───────────────────────────────────
    const openMenu = () => {
      hamburgerBtn.classList.add('active');
      mobileMenu.classList.add('open');
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      mobileMenu.setAttribute('aria-hidden', 'false');
      navbar.classList.add('menu-open');
      document.body.style.overflow = 'hidden'; // prevent bg scroll
    };

    const closeMenu = () => {
      hamburgerBtn.classList.remove('active');
      mobileMenu.classList.remove('open');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      navbar.classList.remove('menu-open');
      document.body.style.overflow = '';
    };

    hamburgerBtn.addEventListener('click', () => {
      const isOpen = hamburgerBtn.classList.contains('active');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close when a nav link is clicked
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Close on resize to desktop
    const mediaQuery = window.matchMedia('(min-width: 1024px)');
    mediaQuery.addEventListener('change', (e) => {
      if (e.matches) closeMenu();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburgerBtn.classList.contains('active')) {
        closeMenu();
        hamburgerBtn.focus();
      }
    });
  }
</script>