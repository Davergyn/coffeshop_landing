---
// Location.astro — Location & opening hours section

const whatsappNumber = "[WHATSAPP NUMBER]";
const instagramUrl = "[INSTAGRAM URL]"; // contoh: https://instagram.com/coffeeshop
const googleMapsUrl = "[GOOGLE MAPS URL]"; // contoh: https://maps.google.com/?q=...
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Halo,%20saya%20ingin%20bertanya`;

const openingHours = [
  { days: "Senin — Jumat", hours: "08:00 — 22:00" },
  { days: "Sabtu — Minggu", hours: "07:00 — 23:00" },
];
---

<section
  id="location"
  class="location-section section-py"
  aria-labelledby="location-heading"
>
  <div class="container-base">
    <div class="location-grid">
      <!-- Map placeholder / embed area -->
      <div class="location-map reveal-fade">
        <div class="map-embed">
          <!-- In production: replace with actual Google Maps embed iframe -->
          <!-- <iframe
            src="https://www.google.com/maps/embed?pb=..."
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Peta lokasi [COFFEE SHOP NAME]"
          ></iframe> -->

          <!-- Placeholder map visual -->
          <div class="map-placeholder" aria-hidden="true">
            <div class="map-bg">
              <img
                src="https://images.unsplash.com/photo-1524661135-423995f22d0b?w=800&q=70&auto=format&fit=crop"
                alt="Ilustrasi peta kota"
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
              <div class="map-pin-overlay">
                <div class="map-pin-badge">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                  </svg>
                  <span>[COFFEE SHOP NAME]</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Get Directions overlay button -->
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="map-btn"
            id="location-get-directions"
            aria-label="Buka di Google Maps"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="3 11 22 2 13 21 11 13 3 11"/>
            </svg>
            Buka di Google Maps
          </a>
        </div>
      </div>

      <!-- Info column -->
      <div class="location-info">
        <p class="eyebrow reveal mb-5">Kunjungi Kami</p>
        <h2
          id="location-heading"
          class="section-heading reveal delay-100 mb-8"
        >
          Temukan kami<br />
          di <em class="italic" style="color: var(--color-caramel)">[CITY].</em>
        </h2>

        <!-- Address -->
        <div class="info-block reveal delay-200">
          <div class="info-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <p class="info-label">Alamat</p>
            <address class="info-value not-italic">
              [STREET ADDRESS]<br />
              [CITY], Indonesia
            </address>
          </div>
        </div>

        <!-- Hours -->
        <div class="info-block reveal delay-300">
          <div class="info-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div>
            <p class="info-label">Jam Buka</p>
            <ul class="hours-list" role="list">
              {openingHours.map((item) => (
                <li class="hours-row">
                  <span class="hours-days">{item.days}</span>
                  <span class="hours-time">{item.hours}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Contact -->
        <div class="info-block reveal delay-400">
          <div class="info-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </div>
          <div>
            <p class="info-label">Hubungi Kami</p>
            <div class="contact-links">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-link"
                id="location-whatsapp"
                aria-label="Chat via WhatsApp"
              >
                WhatsApp
              </a>
              <span class="contact-sep" aria-hidden="true">·</span>
              <a
                href={instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-link"
                id="location-instagram"
                aria-label="Kunjungi Instagram kami"
              >
                Instagram
              </a>
            </div>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="location-actions reveal delay-500">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            id="location-directions-btn"
          >
            Dapatkan Petunjuk Arah
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
            id="location-wa-btn"
          >
            Hubungi via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .location-section {
    background-color: var(--color-cream-dark);
  }

  /* Grid */
  .location-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .location-grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  /* Map */
  .location-map {
    position: relative;
  }

  .map-embed {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background-color: var(--color-sand);
  }

  .map-placeholder {
    width: 100%;
    height: 100%;
  }

  .map-bg {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .map-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.7) sepia(0.2);
  }

  .map-pin-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-pin-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-espresso);
    color: var(--color-cream);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.75rem 1.25rem;
    border-radius: 9999px;
    box-shadow: 0 4px 20px rgba(28,20,16,0.4);
  }

  .map-btn {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-white);
    color: var(--color-espresso);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    box-shadow: 0 2px 12px rgba(28,20,16,0.15);
    transition: box-shadow 0.2s ease;
  }

  .map-btn:hover {
    box-shadow: 0 4px 20px rgba(28,20,16,0.2);
  }

  /* Info blocks */
  .info-block {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .info-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background-color: var(--color-sand);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brown);
    margin-top: 0.1rem;
  }

  .info-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-caramel);
    margin-bottom: 0.4rem;
  }

  .info-value {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-espresso);
  }

  /* Hours */
  .hours-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .hours-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.95rem;
  }

  .hours-days {
    color: var(--color-espresso);
    min-width: 160px;
  }

  .hours-time {
    color: var(--color-muted);
    font-weight: 500;
  }

  /* Contact links */
  .contact-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .contact-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-espresso);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: var(--color-brown);
  }

  .contact-sep {
    color: var(--color-muted);
  }

  /* Action buttons */
  .location-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }
</style>
