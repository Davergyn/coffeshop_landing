---
// CTA.astro — Final call-to-action section before footer

const whatsappNumber = "[WHATSAPP NUMBER]";
const googleMapsUrl  = "[GOOGLE MAPS URL]";
const whatsappUrl    = `https://wa.me/${whatsappNumber}?text=Halo,%20saya%20ingin%20memesan`;
---

<section
  class="cta-section"
  aria-labelledby="cta-heading"
>
  <!-- Background image -->
  <div class="cta-bg" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=1600&q=75&auto=format&fit=crop"
      alt=""
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
    <div class="cta-overlay"></div>
  </div>

  <!-- Content -->
  <div class="container-base cta-content">
    <div class="cta-inner">
      <p class="eyebrow cta-eyebrow reveal mb-6">
        Sampai Jumpa di Sini
      </p>

      <h2
        id="cta-heading"
        class="cta-headline reveal delay-100"
      >
        Coffee break berikutnya<br />
        <em>dimulai dari sini.</em>
      </h2>

      <p class="cta-desc reveal delay-200">
        Datang, pesan favoritmu, dan biarkan waktu berjalan lebih lambat.<br class="hidden md:block" />
        Kami selalu siap menyambutmu.
      </p>

      <div class="cta-actions reveal delay-300">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary cta-btn-primary"
          id="cta-whatsapp-order"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Order via WhatsApp
        </a>
        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
          id="cta-find-us"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Temukan Kami
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    min-height: 540px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .cta-section {
      min-height: 640px;
    }
  }

  /* Background */
  .cta-bg {
    position: absolute;
    inset: 0;
  }

  .cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.75);
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(28, 20, 16, 0.88) 0%,
      rgba(46, 29, 14, 0.75) 100%
    );
  }

  /* Content */
  .cta-content {
    position: relative;
    z-index: 10;
    padding-block: 5rem;
  }

  .cta-inner {
    max-width: 700px;
  }

  /* Eyebrow override */
  .cta-eyebrow {
    color: var(--color-latte) !important;
  }

  .cta-eyebrow::before,
  .cta-eyebrow::after {
    background-color: var(--color-latte) !important;
  }

  /* Headline */
  .cta-headline {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    margin-bottom: 1.5rem;
  }

  .cta-headline em {
    font-style: italic;
    color: var(--color-latte);
  }

  /* Description */
  .cta-desc {
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    line-height: 1.75;
    color: rgba(250, 247, 242, 0.7);
    margin-bottom: 2.5rem;
  }

  /* Actions */
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Primary button override for dark bg */
  .cta-btn-primary {
    background-color: var(--color-cream);
    color: var(--color-espresso);
    border-color: var(--color-cream);
  }

  .cta-btn-primary:hover {
    background-color: var(--color-sand);
    border-color: var(--color-sand);
    color: var(--color-espresso);
  }
</style>
